@model Employee
<div class="page-head"><div><h1>Register New Employee</h1><p>Add a complete employee record and login account.</p></div></div>
<div class="card">
<form method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div class="form-grid">
<div><label>Full Name *</label><input asp-for="FullName" /></div>
<div><label>National ID Number *</label><input asp-for="NationalId" /></div>
<div><label>Gender *</label><select asp-for="Gender"><option>Male</option><option>Female</option></select></div>
<div><label>City *</label><input asp-for="City" /></div>
<div><label>Telephone *</label><input asp-for="Telephone" /></div>
<div><label>Email *</label><input asp-for="Email" /></div>
<div><label>Registration Date *</label><input asp-for="RegistrationDate" type="date" /></div>
<div><label>Department *</label><select asp-for="DepartmentId">@foreach(var d in (List<Department>)ViewBag.Departments){<option value="@d.Id">@d.Name (@d.RequiredWorkers)</option>}</select></div>
<div><label>Employee Photo</label><input name="Photo" type="file" accept=".jpg,.jpeg,.png,.webp" /></div>
<div><label>Initial Login Password</label><input name="password" type="password" placeholder="Default: Welcome@123" /></div>
</div>
<span asp-validation-for="FullName" class="field-error"></span>
<div class="note">The system automatically creates a unique Employee ID such as AWM-4F2A91 and the first monthly payment record.</div>
<button class="button primary" type="submit">REGISTER EMPLOYEE</button>
<a class="button" asp-action="Index">Cancel</a>
</form></div>